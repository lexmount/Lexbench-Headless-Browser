    "fixture_id": "probe_c17_textencoder",
    "kind": "self_hosted_fixture",
    "url": "/fixtures/l2_round3/probe_c17_textencoder.html"
  },
  "subset_id": "l2.web_platform",
  "tags": [
    "purpose.diagnostic",
    "purpose.regression_parity",
    "version.v0_1"
  ],
  "task_id": "r3_probe_c17_textencoder",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "TextEncoder/TextDecoder"
}
