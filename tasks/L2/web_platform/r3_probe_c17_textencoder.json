{
  "artifact_profile": "l2_standard",
  "description": "Runs a fixture-backed Web-platform semantics probe for TextEncoder/TextDecoder. The driver reads output from the self-hosted fixture `/fixtures/l2_round3/probe_c17_textencoder.html`, and the server-side grader compares it with the checked-in expected answer.",
  "driver": {
    "connect_env": "BROWSER_WS",
    "env": {
      "PROBE_SPEC": {
        "read": "textContent",
        "selector": "#out",
        "settle": "nonempty",
        "settle_timeout_ms": 3000,
        "wait_ms": 250
      }
    },
    "kind": "node_cdp_probe",
    "script": "runner/scripts/l2_fixture_probe.js"
  },
  "features": [
    "web.encoding.text_encoder"
  ],
  "grader": {
    "checks": [
      "answer_matches_expected"
    ],
