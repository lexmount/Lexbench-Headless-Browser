{
  "artifact_profile": "l2_standard",
  "description": "Runs a fixture-backed Web-platform semantics probe for IndexedDB notes lookup. The driver reads output from the self-hosted fixture `/fixtures/l2_round4/notes_idb.html`, and the server-side grader compares it with the checked-in expected answer.",
  "driver": {
    "connect_env": "BROWSER_WS",
    "env": {
      "PROBE_SPEC": {
        "read": "textContent",
        "selector": "#answer",
        "settle": "nonempty",
        "settle_timeout_ms": 8000,
        "wait_ms": 400
      }
    },
    "kind": "node_cdp_probe",
    "script": "runner/scripts/l2_fixture_probe.js"
  },
  "features": [
    "web.storage.indexeddb"
  ],
  "grader": {
    "checks": [
      "answer_contains_all_keywords"
    ],
    "endpoint": "/__grade__/expected_answer",
    "kind": "server_side"
  },
  "human_query": "在这个笔记应用里,找到标签是「报销」的那条笔记,把里面的内容念给我听。",
  "layer": "L2",
  "scene": {
    "fixture_id": "q06_notes_idb",
    "kind": "self_hosted_fixture",
    "url": "/fixtures/l2_round4/notes_idb.html"
  },
  "subset_id": "l2.web_platform",
  "tags": [
    "version.v0_1"
  ],
  "task_id": "r4_q06_notes_idb",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "IndexedDB notes lookup"
}
