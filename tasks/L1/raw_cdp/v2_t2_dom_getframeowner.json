{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "On an iframe host page, Page.getFrameTree yields the child frameId and DOM.getFrameOwner returns the backendNodeId of the owning <iframe> element (puppeteer/agent-browser oopif adoption path).",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Page.enable",
        "optional": true,
        "params": {}
      },
      {
        "method": "DOM.enable",
        "optional": true,
        "params": {}
      },
      {
        "method": "Page.getFrameTree",
        "save_result_as": "tree"
      },
      {
        "method": "DOM.getFrameOwner",
        "params": {
          "frameId": "{saved:tree.frameTree.childFrames.0.frame.id}"
