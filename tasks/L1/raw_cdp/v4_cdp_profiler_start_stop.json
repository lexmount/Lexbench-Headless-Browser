{
  "artifact_profile": "l1_standard",
  "description": "Runs a CPU profile and asserts Profiler.stop returns a profile with a node tree.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Profiler.enable"
      },
      {
        "method": "Profiler.start"
      },
      {
        "method": "Profiler.stop",
        "save_result_as": "p"
      },
      {
        "method": "Profiler.disable"
      }
    ]
  },
  "features": [
    "cdp.profiler.start"
  ],
  "grader": {
    "checks": [
      {
        "kind": "saved_path_truthy",
        "label": "profile_nodes_present",
        "name": "p",
        "path": "profile.nodes"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.diagnostics",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_profiler_start_stop",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 15000
  },
  "title": "Profiler.start then Profiler.stop returns a profile"
}
