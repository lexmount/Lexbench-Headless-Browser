{
  "artifact_profile": "l1_standard",
  "description": "Stops a running violations report; exercises Log.stopViolationsReport.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Log.enable"
      },
      {
        "method": "Log.startViolationsReport",
        "params": {
          "config": [
            {
              "name": "longTask",
              "threshold": 100
            }
          ]
        }
      },
      {
        "method": "Log.stopViolationsReport"
      }
    ]
  },
  "features": [
    "cdp.log.stop_violations_report"
  ],
  "grader": {
    "checks": [
      {
        "kind": "no_error",
        "label": "command_completed"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.log",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_log_stopviolationsreport",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 15000
  },
  "title": "Log.stopViolationsReport is accepted"
}
