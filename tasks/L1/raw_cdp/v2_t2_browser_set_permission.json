  "chrome_gate": "best_effort",
  "description": "Browser.setPermission sets geolocation to 'denied' for the default context; navigator.permissions.query then reports 'denied', confirming the single-permission API path (puppeteer).",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Browser.setPermission",
        "params": {
          "permission": {
            "name": "geolocation"
          },
          "setting": "denied"
        },
        "session": "browser"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "awaitPromise": true,
          "expression": "navigator.permissions.query({name:'geolocation'}).then(function(p){return p.state;})",
          "returnByValue": true
        },
        "save_as": "state"
      },
      {
        "method": "Browser.resetPermissions",
        "optional": true,
        "params": {},
        "session": "browser"
      }
    ]
  },
