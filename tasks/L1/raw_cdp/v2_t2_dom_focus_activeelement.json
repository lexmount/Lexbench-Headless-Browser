  "description": "DOM.focus is applied to the #field text input, then Runtime.evaluate reads document.activeElement.id and confirms focus moved to the targeted element (browser-use pre-typing focus strategy).",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable",
        "optional": true,
        "params": {}
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": 1
        },
        "save_result_as": "doc"
      },
      {
        "method": "DOM.querySelector",
        "params": {
          "nodeId": "{saved:doc.root.nodeId}",
          "selector": "#field"
        },
        "save_result_as": "found"
      },
      {
        "method": "DOM.focus",
        "params": {
          "nodeId": "{saved:found.nodeId}"
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "(document.activeElement && document.activeElement.id) || ''",
          "returnByValue": true
        },
        "save_as": "active"
      }
    ]
  },
  "features": [
    "cdp.dom.focus",
    "cdp.dom.query_selector",
    "cdp.runtime.evaluate"
  ],
