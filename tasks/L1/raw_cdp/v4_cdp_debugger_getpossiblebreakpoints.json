{
  "artifact_profile": "l1_standard",
  "description": "Asks for possible breakpoint locations in the parsed script and asserts a non-empty list.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Runtime.enable"
      },
      {
        "method": "Debugger.enable",
        "save_result_as": "dbg"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "//# sourceURL=v4probe.js\nfunction v4f(a){var b=a+1;return b;}\nwindow.v4f=v4f;\nvar v4K=12345;\n"
        }
      },
      {
        "match": {
          "url": "v4probe.js"
        },
        "save_result_as": "sp",
        "timeout_ms": 3000,
        "wait_for_event": "Debugger.scriptParsed"
      },
      {
        "method": "Debugger.getPossibleBreakpoints",
        "params": {
          "start": {
            "lineNumber": 0,
            "scriptId": "{saved:sp.scriptId}"
          }
        },
        "save_result_as": "pb"
      },
      {
        "method": "Debugger.disable"
      }
    ]
  },
  "features": [
    "cdp.debugger.get_possible_breakpoints"
  ],
  "grader": {
    "checks": [
      {
        "kind": "array_length",
        "label": "breakpoint_locations",
        "min": 1,
        "name": "pb",
        "path": "locations"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.bootstrap",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_debugger_getpossiblebreakpoints",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Debugger.getPossibleBreakpoints lists locations"
}
