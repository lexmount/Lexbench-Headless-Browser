{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "Fetch.enable called with no patterns (intercept every request). A single page fetch() is paused, then released with Fetch.continueRequest; the page receives the real origin body. Contrasts with the pattern-scoped enable and exercises the pattern-less interception form.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Fetch.enable",
        "params": {}
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbGet(location.origin+'/v0_2/fetch/abbfetch-real?n='+Date.now())"
        }
      },
      {
        "save_result_as": "paused",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Fetch.requestPaused"
      },
      {
        "method": "Fetch.continueRequest",
        "params": {
          "requestId": "{saved:paused.requestId}"
        }
      },
      {
        "sleep_ms": 400
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbBody",
          "returnByValue": true
        },
        "save_as": "body"
      }
    ]
  },
  "features": [
    "cdp.fetch.enable",
    "cdp.fetch.continue_request"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Fetch.requestPaused",
        "name": "paused"
      },
      {
        "expected": "REAL-SERVER-BODY",
        "kind": "value_contains",
        "name": "body"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_2/fetch/page"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.fetch",
    "version.v0_2"
  ],
  "task_id": "v2_fetch_enable_no_patterns",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Fetch.enable() without patterns intercepts all requests"
}
