{
  "artifact_profile": "l1_standard",
  "description": "Creates a text node, resolves its frontend node id via DOM.requestNode, and edits it with DOM.setNodeValue.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable"
      },
      {
        "method": "Runtime.enable"
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": -1
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "(function(){var t=document.createTextNode('orig');document.body.appendChild(t);return t;})()",
          "returnByValue": false
        },
        "save_result_as": "t"
      },
      {
        "method": "DOM.requestNode",
        "params": {
          "objectId": "{saved:t.result.objectId}"
        },
        "save_result_as": "rn"
      },
      {
        "method": "DOM.setNodeValue",
        "params": {
          "nodeId": "{saved:rn.nodeId}",
          "value": "changed"
        }
      }
    ]
  },
  "features": [
    "cdp.dom.set_node_value"
  ],
  "grader": {
    "checks": [
      {
        "kind": "no_error",
        "label": "command_completed"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
