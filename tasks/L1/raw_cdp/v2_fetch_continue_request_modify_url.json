{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "The page fetches the 'real' route, but Fetch.continueRequest overrides the request url to a different origin route ('truth'); the server therefore serves the other resource and the page renders the truth body. Proves continueRequest url rewriting reaches the origin.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "location.origin+'/v0_2/fetch/abbfetch-truth'",
          "returnByValue": true
        },
        "save_as": "truthurl"
      },
      {
        "method": "Fetch.enable",
        "params": {
          "patterns": [
            {
              "requestStage": "Request",
              "urlPattern": "*abbfetch-real*"
            }
          ]
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbGet(location.origin+'/v0_2/fetch/abbfetch-real?n='+Date.now())"
        }
      },
      {
        "save_result_as": "paused",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Fetch.requestPaused"
      },
      {
        "method": "Fetch.continueRequest",
        "params": {
          "requestId": "{saved:paused.requestId}",
          "url": "{saved:truthurl.result.value}"
        }
      },
      {
        "sleep_ms": 400
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbBody",
          "returnByValue": true
        },
        "save_as": "body"
      }
    ]
  },
  "features": [
    "cdp.fetch.enable",
    "cdp.fetch.request_paused",
    "cdp.fetch.continue_request"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Fetch.requestPaused",
        "name": "paused"
      },
      {
        "expected": "ROUTE-TRUTH-BODY",
        "kind": "value_contains",
        "name": "body"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_2/fetch/page"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.fetch",
    "version.v0_2"
  ],
  "task_id": "v2_fetch_continue_request_modify_url",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Fetch.continueRequest rewrites the request URL"
}
