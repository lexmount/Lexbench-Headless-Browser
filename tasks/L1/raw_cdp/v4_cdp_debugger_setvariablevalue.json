{
  "artifact_profile": "l1_standard",
  "description": "Sets a local variable in the paused frame's scope via Debugger.setVariableValue.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Runtime.enable"
      },
      {
        "method": "Debugger.enable",
        "save_result_as": "dbg"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "setTimeout(function(){var localX=1; debugger; window.__lx=localX;},30)"
        }
      },
      {
        "save_result_as": "pz",
        "timeout_ms": 4000,
        "wait_for_event": "Debugger.paused"
      },
      {
        "method": "Debugger.setVariableValue",
        "params": {
          "callFrameId": "{saved:pz.callFrames.0.callFrameId}",
          "newValue": {
            "value": 9
          },
          "scopeNumber": 0,
          "variableName": "localX"
        }
      },
      {
        "method": "Debugger.resume"
      },
      {
        "method": "Debugger.disable"
      }
    ]
  },
  "features": [
    "cdp.debugger.set_variable_value"
  ],
  "grader": {
    "checks": [
      {
        "kind": "no_error",
        "label": "command_completed"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.bootstrap",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_debugger_setvariablevalue",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Debugger.setVariableValue in a paused scope"
}
