{
  "artifact_profile": "l1_standard",
  "description": "Replaces #bottom's outer HTML via DOM.setOuterHTML; the command must be accepted.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable"
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": 0
        },
        "save_result_as": "d"
      },
      {
        "method": "DOM.querySelector",
        "params": {
          "nodeId": "{saved:d.root.nodeId}",
          "selector": "#bottom"
        },
        "save_result_as": "q"
      },
      {
        "method": "DOM.setOuterHTML",
        "params": {
          "nodeId": "{saved:q.nodeId}",
          "outerHTML": "<div id=\"bottom\">edited</div>"
        }
      }
    ]
  },
  "features": [
    "cdp.dom.set_outer_html"
  ],
  "grader": {
    "checks": [
      {
        "kind": "no_error",
        "label": "command_completed"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.actions",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_dom_setouterhtml",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "DOM.setOuterHTML replaces an element"
}
