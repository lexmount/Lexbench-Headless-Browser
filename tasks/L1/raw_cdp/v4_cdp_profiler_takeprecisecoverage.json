{
  "artifact_profile": "l1_standard",
  "description": "Takes a precise-coverage snapshot and asserts the timestamped result shape.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Profiler.enable"
      },
      {
        "method": "Profiler.startPreciseCoverage",
        "params": {
          "callCount": true,
          "detailed": false
        }
      },
      {
        "method": "Profiler.takePreciseCoverage",
        "save_result_as": "c"
      },
      {
        "method": "Profiler.stopPreciseCoverage"
      },
      {
        "method": "Profiler.disable"
      }
    ]
  },
  "features": [
    "cdp.profiler.take_precise_coverage"
  ],
  "grader": {
    "checks": [
      {
        "kind": "saved_path_truthy",
        "label": "coverage_result",
        "name": "c",
        "path": "timestamp"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.diagnostics",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_profiler_takeprecisecoverage",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 15000
  },
  "title": "Profiler.takePreciseCoverage returns a result list"
}
