{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "Runtime.getProperties(accessorPropertiesOnly:true) over a page object: filters window.__probeObj down to its accessor properties only. Verifies the data properties (alpha/beta/nested) are excluded and the lone accessor 'computed' comes back with a getter function descriptor. Complements the own-properties probe by exercising the accessor filter.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__probeObj"
        },
        "save_result_as": "obj"
      },
      {
        "method": "Runtime.getProperties",
        "params": {
          "accessorPropertiesOnly": true,
          "objectId": "{saved:obj.result.objectId}",
          "ownProperties": true
        },
        "save_result_as": "props"
      }
    ]
  },
  "features": [
    "cdp.runtime.get_properties"
  ],
  "grader": {
    "checks": [
      {
        "kind": "array_length",
        "min": 1,
        "name": "props",
        "path": "result"
      },
      {
        "expected": {
          "get": {
            "type": "function"
          },
          "name": "computed"
        },
        "kind": "array_contains",
        "name": "props",
        "path": "result"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
