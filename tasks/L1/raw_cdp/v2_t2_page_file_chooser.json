{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "With Page.setInterceptFileChooserDialog(true), clicking a file input raises Page.fileChooserOpened instead of a native picker. Asserts the event arrives and reports single-file selection mode.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Page.enable"
      },
      {
        "method": "Page.setInterceptFileChooserDialog",
        "params": {
          "enabled": true
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "document.getElementById('fileinput').click(); 'ok'",
          "userGesture": true
        }
      },
      {
        "save_result_as": "fc",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Page.fileChooserOpened"
      }
    ]
  },
  "features": [
    "cdp.page.set_intercept_file_chooser_dialog",
    "cdp.page.file_chooser_opened"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Page.fileChooserOpened",
        "name": "fc"
      },
      {
        "expected": "selectSingle",
        "kind": "saved_path_equals",
        "name": "fc",
        "path": "mode"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v2/t2a/interactive"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.tier2_a",
    "version.v0_2"
  ],
  "task_id": "v2_t2_page_file_chooser",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Page.setInterceptFileChooserDialog + fileChooserOpened"
}
