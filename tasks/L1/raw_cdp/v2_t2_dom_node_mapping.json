{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "Closes the DOM.getDocument nodeId -> DOM.describeNode backendNodeId -> DOM.resolveNode objectId -> DOM.requestNode nodeId round trip on the #inc button, then Runtime.callFunctionOn on the resolved objectId returns the element id, proving the three-way handle mapping refers to the same node.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable",
        "optional": true,
        "params": {}
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": 1
        },
        "save_result_as": "doc"
      },
      {
        "method": "DOM.querySelector",
        "params": {
          "nodeId": "{saved:doc.root.nodeId}",
          "selector": "#inc"
        },
        "save_result_as": "found"
      },
      {
        "method": "DOM.describeNode",
        "params": {
          "nodeId": "{saved:found.nodeId}"
        },
        "save_result_as": "desc"
      },
      {
        "method": "DOM.resolveNode",
        "params": {
          "backendNodeId": "{saved:desc.node.backendNodeId}"
        },
        "save_result_as": "resolved"
      },
      {
        "method": "DOM.requestNode",
        "params": {
          "objectId": "{saved:resolved.object.objectId}"
        },
        "save_result_as": "req"
      },
      {
        "method": "Runtime.callFunctionOn",
        "params": {
          "functionDeclaration": "function(){return this.id;}",
          "objectId": "{saved:resolved.object.objectId}",
          "returnByValue": true
        },
        "save_as": "elid"
      }
    ]
  },
  "features": [
    "cdp.dom.get_document",
    "cdp.dom.query_selector",
    "cdp.dom.describe_node",
    "cdp.dom.resolve_node",
    "cdp.dom.request_node",
    "cdp.runtime.call_function_on"
  ],
  "grader": {
    "checks": [
      {
        "kind": "saved_path_truthy",
        "name": "desc",
        "path": "node.backendNodeId"
      },
      {
        "kind": "saved_path_truthy",
        "name": "resolved",
        "path": "object.objectId"
      },
      {
        "kind": "saved_path_truthy",
        "name": "req",
        "path": "nodeId"
      },
      {
        "expected": "inc",
        "kind": "value_equals",
        "name": "elid"
      }
    ],
    "kind": "inline_assertions"
  },
