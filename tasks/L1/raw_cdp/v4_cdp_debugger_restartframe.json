{
  "artifact_profile": "l1_standard",
  "description": "Pauses at a nested `debugger;` statement, then restarts the top call frame via Debugger.restartFrame(mode=StepInto). Chrome returns an empty callFrames list in the direct result but re-pauses at the start of the restarted frame, so the task asserts the follow-up Debugger.paused event is delivered.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Runtime.enable"
      },
      {
        "method": "Debugger.enable",
        "save_result_as": "dbg"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "setTimeout(function(){function inner(){debugger;} inner();},30)"
        }
      },
      {
        "save_result_as": "pz",
        "timeout_ms": 4000,
        "wait_for_event": "Debugger.paused"
      },
      {
        "method": "Debugger.restartFrame",
        "params": {
          "callFrameId": "{saved:pz.callFrames.0.callFrameId}",
          "mode": "StepInto"
        }
      },
      {
        "timeout_ms": 3000,
        "wait_for_event": "Debugger.paused"
      },
      {
        "method": "Debugger.resume"
      },
      {
        "method": "Debugger.disable"
      }
    ]
  },
  "features": [
    "cdp.debugger.restart_frame"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "label": "restart_frame_repause",
        "method": "Debugger.paused"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.bootstrap",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_debugger_restartframe",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Debugger.restartFrame re-pauses the restarted frame"
}
