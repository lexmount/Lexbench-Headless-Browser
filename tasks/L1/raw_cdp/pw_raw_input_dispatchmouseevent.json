        }
      },
      {
        "method": "Input.dispatchMouseEvent",
        "optional": false,
        "params": {
          "button": "left",
          "clickCount": 1,
          "type": "mousePressed",
          "x": 20,
          "y": 60
        }
      },
      {
        "method": "Input.dispatchMouseEvent",
        "optional": false,
        "params": {
          "button": "left",
          "clickCount": 1,
          "type": "mouseReleased",
          "x": 20,
          "y": 60
        }
      },
      {
        "method": "Runtime.evaluate",
        "optional": false,
        "params": {
          "expression": "document.querySelector(\"#count\").textContent",
          "returnByValue": true
        },
        "save_as": "value"
      }
