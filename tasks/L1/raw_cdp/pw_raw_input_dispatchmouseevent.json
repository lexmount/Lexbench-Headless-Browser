{
  "artifact_profile": "l1_standard",
  "description": "Verifies raw.input.dispatchMouseEvent by issuing raw CDP command(s) Page.enable, Runtime.enable, Page.navigate, Runtime.evaluate, ... against an about:blank page. It passes when every non-optional CDP step completes without a protocol error. Optional steps are best-effort, and returned values are not graded.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Page.enable",
        "optional": false,
        "params": {}
      },
      {
        "method": "Runtime.enable",
        "optional": false,
        "params": {}
      },
      {
        "method": "Page.navigate",
        "optional": false,
        "params": {
          "url": "{fixture_url}"
        }
      },
      {
        "method": "Runtime.evaluate",
        "optional": true,
        "params": {
          "expression": "document.querySelector(\"#inc\").getBoundingClientRect().toJSON ? 0 : 0",
