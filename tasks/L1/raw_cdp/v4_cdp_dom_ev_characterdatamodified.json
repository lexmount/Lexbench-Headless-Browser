{
  "artifact_profile": "l1_standard",
  "description": "Asserts DOM.characterDataModified fires when a tracked text node's value changes.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable"
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": -1
        }
      },
      {
        "method": "Runtime.enable"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "document.getElementById('count').firstChild.nodeValue='changed'"
        }
      },
      {
        "timeout_ms": 3000,
        "wait_for_event": "DOM.characterDataModified"
      }
    ]
  },
  "features": [
    "cdp.dom.character_data_modified"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "label": "chardata_event",
        "method": "DOM.characterDataModified"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
