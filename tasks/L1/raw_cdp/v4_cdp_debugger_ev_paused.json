{
  "artifact_profile": "l1_standard",
  "description": "Triggers a `debugger;` statement and asserts Debugger.paused carries a call-frame.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Runtime.enable"
      },
      {
        "method": "Debugger.enable",
        "save_result_as": "dbg"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "setTimeout(function(){debugger; window.__v4done=1;},30)"
        }
      },
      {
        "save_result_as": "pz",
        "timeout_ms": 4000,
        "wait_for_event": "Debugger.paused"
      },
      {
        "method": "Debugger.resume"
      },
      {
        "method": "Debugger.disable"
      }
    ]
  },
  "features": [
    "cdp.debugger.paused"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "label": "paused_event",
        "method": "Debugger.paused"
      },
      {
        "kind": "saved_path_truthy",
        "label": "has_call_frame",
        "name": "pz",
        "path": "callFrames.0.callFrameId"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.bootstrap",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_debugger_ev_paused",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Debugger.paused fires on a debugger statement"
}
