{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "v0.2 demo: exercises the Target handshake chain — Target.setAutoAttach + Target.createTarget on the browser session, waits for the Target.attachedToTarget event, captures the flat child session, and runs Runtime.evaluate on that new session. Demonstrates step-level session addressing, wait_for_event, and save_session_as.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Target.setAutoAttach",
        "params": {
          "autoAttach": true,
          "flatten": true,
          "waitForDebuggerOnStart": false
        },
        "session": "browser"
      },
      {
        "method": "Target.createTarget",
        "params": {
          "url": "about:blank"
        },
        "save_result_as": "created",
        "session": "browser"
      },
      {
        "match": {
          "targetInfo": {
            "targetId": "{saved:created.targetId}"
          }
        },
        "save_result_as": "attached",
        "save_session_as": "child",
        "timeout_ms": 4000,
        "wait_for_event": "Target.attachedToTarget"
      },
      {
        "method": "Runtime.enable",
        "optional": true,
        "session": "child"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "6 * 7",
          "returnByValue": true
        },
        "save_as": "answer",
        "session": "child"
      },
      {
        "method": "Target.closeTarget",
        "optional": true,
        "params": {
          "targetId": "{saved:created.targetId}"
        },
        "session": "browser"
      }
    ]
  },
  "features": [
    "cdp.target.set_auto_attach",
    "cdp.target.create_target",
    "cdp.target.attach_to_target",
    "cdp.target.attached_to_target"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Target.attachedToTarget",
        "name": "attached"
      },
      {
        "expected": "page",
        "kind": "saved_path_equals",
        "name": "attached",
        "path": "targetInfo.type"
      },
      {
        "expected": 42,
        "kind": "value_equals",
        "name": "answer"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "about_blank"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "coverage.tier1_bootstrap",
    "purpose.demo"
  ],
  "task_id": "v2demo_target_attach_handshake",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 15000
  },
  "title": "Target attach handshake chain"
}
