{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "A data table whose visible cells read 'see summary' while each cell's aria-label carries the real figure. getFullAXTree exposes the role-structured table (rowheader/columnheader/cell) and the per-cell accessible names ('North total is 7420', 'South total is 3155'). The figures are only obtainable via the AX tree.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Page.enable",
        "optional": true
      },
      {
        "method": "Runtime.enable",
        "optional": true
      },
      {
        "method": "DOM.enable",
        "optional": true
      },
      {
        "method": "Accessibility.enable",
        "optional": true
      },
      {
        "method": "Accessibility.getFullAXTree",
        "save_result_as": "ax"
      }
    ]
  },
  "features": [
    "cdp.accessibility.get_full_ax_tree",
    "web.ax.role.table",
    "web.ax.name"
  ],
  "grader": {
