{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "Two action buttons: 'Save' (enabled) and 'Publish' (disabled). getFullAXTree exposes both buttons and the 'disabled' AX property on Publish. Nodes are located by role+name identity, not by array position.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Page.enable",
        "optional": true
      },
      {
        "method": "Runtime.enable",
        "optional": true
      },
      {
        "method": "DOM.enable",
        "optional": true
      },
      {
        "method": "Accessibility.enable",
        "optional": true
      },
      {
        "method": "Accessibility.getFullAXTree",
        "save_result_as": "ax"
      }
    ]
  },
  "features": [
    "cdp.accessibility.get_full_ax_tree",
    "web.ax.state.disabled"
  ],
  "grader": {
    "checks": [
      {
        "expected": {
          "name": {
            "value": "Save"
          },
          "role": {
            "value": "button"
          }
        },
        "kind": "array_contains",
        "name": "ax",
        "path": "nodes"
      },
      {
        "contains_path": "properties",
        "expected": {
          "name": "disabled",
          "value": {
            "value": true
          }
        },
        "kind": "array_match_contains",
        "match": {
          "name": {
            "value": "Publish"
          },
          "role": {
            "value": "button"
          }
        },
        "name": "ax",
        "path": "nodes"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v2/axl2/state_summary"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.accessibility_l2",
    "purpose.agent_observation",
    "version.v0_2"
  ],
  "task_id": "v2_axl2_disabled_summary",
  "task_version": 2,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 15000
  },
  "title": "disabled-state summary read from AX properties"
}
