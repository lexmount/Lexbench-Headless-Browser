{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "Fetch.continueRequest with an overridden request headers array (injecting x-abb-injected and Accept) still delivers the origin body to the page. Note: the fixture server does not echo request headers, so server-visible header values cannot be asserted here (documented in skipped_fetch.md); this probe covers the continueRequest header-override parameter path end to end.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Fetch.enable",
        "params": {
          "patterns": [
            {
              "requestStage": "Request",
              "urlPattern": "*abbfetch-real*"
            }
          ]
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbGet(location.origin+'/v0_2/fetch/abbfetch-real?n='+Date.now())"
        }
      },
      {
        "save_result_as": "paused",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Fetch.requestPaused"
      },
      {
        "method": "Fetch.continueRequest",
        "params": {
          "headers": [
            {
              "name": "x-abb-injected",
              "value": "1"
            },
            {
              "name": "Accept",
              "value": "text/plain"
            }
          ],
          "requestId": "{saved:paused.requestId}"
        }
      },
      {
        "sleep_ms": 400
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbBody",
          "returnByValue": true
        },
        "save_as": "body"
      }
    ]
  },
  "features": [
    "cdp.fetch.enable",
    "cdp.fetch.continue_request"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Fetch.requestPaused",
        "name": "paused"
      },
      {
        "expected": "REAL-SERVER-BODY",
        "kind": "value_contains",
        "name": "body"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_2/fetch/page"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.fetch",
    "version.v0_2"
  ],
  "task_id": "v2_fetch_continue_request_modify_headers",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Fetch.continueRequest with header/method override"
}
