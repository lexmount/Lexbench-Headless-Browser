{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "v0.2 demo: Accessibility.getFullAXTree over the core fixture, then semantic assertions over the returned AX nodes — the tree has at least a few nodes and contains at least one node with role 'button'. Demonstrates the AX semantic-assertion grader extensions (array_length / array_contains) for T1_agent_observation.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Page.enable",
        "optional": true
      },
      {
        "method": "Runtime.enable",
        "optional": true
      },
      {
        "method": "DOM.enable",
        "optional": true
      },
      {
        "method": "Accessibility.enable",
        "optional": true
      },
      {
        "method": "Accessibility.getFullAXTree",
        "save_result_as": "ax"
      }
    ]
  },
  "features": [
    "cdp.accessibility.enable",
    "cdp.accessibility.get_full_ax_tree"
  ],
  "grader": {
    "checks": [
      {
        "kind": "array_length",
        "min": 3,
        "name": "ax",
        "path": "nodes"
      },
      {
        "expected": {
          "role": {
            "value": "button"
          }
        },
        "kind": "array_contains",
        "name": "ax",
        "path": "nodes"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "purpose.demo"
  ],
  "task_id": "v2demo_ax_role_query",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 15000
  },
  "title": "Accessibility AX role semantic query"
}
