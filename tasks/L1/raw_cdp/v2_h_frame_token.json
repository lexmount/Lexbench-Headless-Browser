{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "Builds a child page session via the dialect handshake, navigates to a parent fixture with a same-origin iframe, verifies the child frame appears in Page.getFrameTree, and reads the token that the child frame computes from a data attribute (reversed 'xy9' => '9yx'). The answer is derived by the child frame at runtime, not a static literal.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Target.setAutoAttach",
        "params": {
          "autoAttach": true,
          "flatten": true,
          "waitForDebuggerOnStart": true
        },
        "session": "browser"
      },
      {
        "method": "Target.createTarget",
        "params": {
          "url": "{fixture_url}"
        },
        "save_result_as": "created",
        "session": "browser"
      },
      {
        "match": {
          "targetInfo": {
            "targetId": "{saved:created.targetId}"
          }
        },
        "save_result_as": "attached",
        "save_session_as": "h_page",
        "timeout_ms": 6000,
        "wait_for_event": "Target.attachedToTarget"
      },
      {
        "method": "Page.enable",
        "session": "h_page"
      },
      {
        "method": "Page.setLifecycleEventsEnabled",
        "params": {
          "enabled": true
        },
        "session": "h_page"
      },
      {
        "method": "Runtime.enable",
        "session": "h_page"
      },
      {
        "method": "Runtime.runIfWaitingForDebugger",
        "session": "h_page"
      },
      {
        "match": {
          "name": "load"
        },
        "save_result_as": "loaded",
        "session": "h_page",
        "timeout_ms": 8000,
        "wait_for_event": "Page.lifecycleEvent"
      },
      {
        "method": "Page.getFrameTree",
        "params": {},
        "save_result_as": "tree",
        "session": "h_page"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.frames[0].document.getElementById('ctoken').textContent;",
          "returnByValue": true
        },
        "save_as": "answer",
        "session": "h_page"
      },
      {
        "method": "Target.closeTarget",
        "optional": true,
        "params": {
          "targetId": "{saved:created.targetId}"
        },
        "session": "browser"
      }
    ]
  },
  "features": [
    "cdp.target.attached_to_target",
    "cdp.page.get_frame_tree",
    "cdp.runtime.run_if_waiting_for_debugger"
  ],
  "grader": {
    "checks": [
      {
        "kind": "array_length",
        "min": 1,
        "name": "tree",
        "path": "frameTree.childFrames"
      },
      {
        "expected": "9yx",
        "kind": "value_equals",
        "name": "answer"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v2/h/frames_parent"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.handwritten",
    "version.v0_2"
  ],
  "task_id": "v2_h_frame_token",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 40000,
    "task_ms": 25000
  },
  "title": "bootstrap replay -> cross-frame token read"
}
