{
  "artifact_profile": "l1_standard",
  "chrome_gate": "best_effort",
  "description": "Network.setCookies writes a cookie scoped to the fixture origin, then Network.getCookies for that URL reads it back. Asserts the returned cookies array contains the exact name/value that was written (cookie store round-trip semantics, not just call success).",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Network.setCookies",
        "params": {
          "cookies": [
            {
              "name": "abb_t2a",
              "url": "{fixture_url}",
              "value": "val42"
            }
          ]
        }
      },
      {
        "method": "Network.getCookies",
        "params": {
          "urls": [
            "{fixture_url}"
          ]
        },
        "save_result_as": "got"
      }
    ]
  },
  "features": [
    "cdp.network.set_cookies",
    "cdp.network.get_cookies"
  ],
  "grader": {
    "checks": [
      {
        "expected": {
          "name": "abb_t2a",
          "value": "val42"
        },
        "kind": "array_contains",
        "name": "got",
        "path": "cookies"
      }
    ],
    "kind": "inline_assertions"
  },
