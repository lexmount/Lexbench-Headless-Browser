{
  "artifact_profile": "l1_standard",
  "description": "Calls console.profileEnd() and asserts Profiler.consoleProfileFinished carries the profile.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Runtime.enable"
      },
      {
        "method": "Profiler.enable"
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "console.profile('v4b');console.profileEnd('v4b');"
        }
      },
      {
        "timeout_ms": 3000,
        "wait_for_event": "Profiler.consoleProfileFinished"
      },
      {
        "method": "Profiler.disable"
      }
    ]
  },
  "features": [
    "cdp.profiler.console_profile_finished"
  ],
