{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "Fetch.fulfillRequest returns a non-2xx status (404) with a custom body for a route that would otherwise return 200; the page observes status 404 and the injected body. Covers fulfillRequest response-code override semantics.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Fetch.enable",
        "params": {
          "patterns": [
            {
              "requestStage": "Request",
              "urlPattern": "*abbfetch-real*"
            }
          ]
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbGet(location.origin+'/v0_2/fetch/abbfetch-real?n='+Date.now())"
        }
      },
      {
        "save_result_as": "paused",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Fetch.requestPaused"
      },
      {
        "method": "Fetch.fulfillRequest",
        "params": {
          "body": "bm90LWhlcmUtNDA0LWJvZHk=",
          "requestId": "{saved:paused.requestId}",
          "responseCode": 404,
          "responseHeaders": [
            {
              "name": "Content-Type",
              "value": "text/plain"
            }
          ]
        }
      },
      {
        "sleep_ms": 400
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbStatus+'|'+window.__abbBody",
          "returnByValue": true
        },
        "save_as": "combo"
      }
    ]
  },
  "features": [
    "cdp.fetch.enable",
    "cdp.fetch.fulfill_request"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Fetch.requestPaused",
        "name": "paused"
      },
      {
        "expected": "404",
        "kind": "value_contains",
        "name": "combo"
      },
      {
        "expected": "not-here-404-body",
        "kind": "value_contains",
        "name": "combo"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_2/fetch/page"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.fetch",
    "version.v0_2"
  ],
  "task_id": "v2_fetch_fulfill_status_override_404",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Fetch.fulfillRequest overrides status to 404"
}
