{
  "artifact_profile": "l1_standard",
  "description": "Renames the #bottom element's tag via DOM.setNodeName and asserts a new node id is returned.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable"
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": 0
        },
        "save_result_as": "d"
      },
      {
        "method": "DOM.querySelector",
        "params": {
          "nodeId": "{saved:d.root.nodeId}",
          "selector": "#bottom"
        },
        "save_result_as": "q"
      },
      {
        "method": "DOM.setNodeName",
        "params": {
          "name": "section",
          "nodeId": "{saved:q.nodeId}"
        },
        "save_result_as": "n"
      }
    ]
  },
  "features": [
    "cdp.dom.set_node_name"
  ],
  "grader": {
    "checks": [
      {
        "kind": "saved_path_truthy",
        "label": "renamed_node_id",
        "name": "n",
        "path": "nodeId"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.actions",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_dom_setnodename",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "DOM.setNodeName returns a new node id"
}
