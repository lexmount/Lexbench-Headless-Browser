{
  "artifact_profile": "l1_standard",
  "description": "Removes a node-removed DOM breakpoint; exercises DOMDebugger.removeDOMBreakpoint.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable"
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": 1
        },
        "save_result_as": "d"
      },
      {
        "method": "DOMDebugger.setDOMBreakpoint",
        "params": {
          "nodeId": "{saved:d.root.nodeId}",
          "type": "node-removed"
        }
      },
      {
        "method": "DOMDebugger.removeDOMBreakpoint",
        "params": {
          "nodeId": "{saved:d.root.nodeId}",
          "type": "node-removed"
        }
      }
    ]
  },
  "features": [
    "cdp.dom_debugger.remove_dom_breakpoint"
  ],
