{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "The app issues two concurrent fetches (/api-answer and /api-second), both matched by patterns. The driver fulfills the first paused request with FULFILLED_ONE and continues the second to the origin. Verifies independent handling of multiple paused requests by requestId.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Fetch.enable",
        "params": {
          "patterns": [
            {
              "requestStage": "Request",
              "urlPattern": "*ifx/api-answer*"
            },
            {
              "requestStage": "Request",
              "urlPattern": "*ifx/api-second*"
            }
          ]
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbTwo(location.origin+'/v0_2/ifx/api-answer', location.origin+'/v0_2/ifx/api-second')"
        }
      },
      {
        "save_result_as": "p1",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Fetch.requestPaused"
      },
      {
        "method": "Fetch.fulfillRequest",
        "params": {
          "body": "eyJhbnN3ZXIiOiJGVUxGSUxMRURfT05FIn0=",
          "requestId": "{saved:p1.requestId}",
          "responseCode": 200,
          "responseHeaders": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      {
        "save_result_as": "p2",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Fetch.requestPaused"
      },
      {
        "method": "Fetch.continueRequest",
        "params": {
          "requestId": "{saved:p2.requestId}"
        }
      },
      {
        "sleep_ms": 600
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "String(window.__a)+'|'+String(window.__b)",
          "returnByValue": true
        },
        "save_as": "combo"
      }
    ]
  },
  "features": [
    "cdp.fetch.enable",
    "cdp.fetch.fulfill_request",
    "cdp.fetch.continue_request"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Fetch.requestPaused",
        "name": "p1"
      },
      {
