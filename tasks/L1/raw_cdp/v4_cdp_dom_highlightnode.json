{
  "artifact_profile": "l1_standard",
  "description": "Highlights #title then hides the overlay; exercises DOM.highlightNode.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "DOM.enable"
      },
      {
        "method": "DOM.getDocument",
        "params": {
          "depth": 0
        },
        "save_result_as": "d"
      },
      {
        "method": "DOM.querySelector",
        "params": {
          "nodeId": "{saved:d.root.nodeId}",
          "selector": "#title"
        },
        "save_result_as": "q"
      },
      {
        "method": "Overlay.enable"
      },
      {
        "method": "DOM.highlightNode",
        "params": {
          "highlightConfig": {
            "contentColor": {
              "a": 0.3,
              "b": 0,
              "g": 255,
              "r": 0
            }
          },
          "nodeId": "{saved:q.nodeId}"
        }
      },
      {
        "method": "DOM.hideHighlight"
      }
    ]
  },
  "features": [
    "cdp.dom.highlight_node"
  ],
  "grader": {
    "checks": [
      {
        "kind": "no_error",
        "label": "command_completed"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.diagnostics",
    "version.v0_4"
  ],
  "task_id": "v4_cdp_dom_highlightnode",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "DOM.highlightNode then hideHighlight"
}
