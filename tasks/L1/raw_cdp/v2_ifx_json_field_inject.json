{
  "artifact_profile": "l1_standard",
  "chrome_gate": "off",
  "description": "The app reads the 'secret' field from /api-answer; the origin JSON has no such field. fulfillRequest returns JSON containing secret=INJECTED_FIELD_VALUE and the page renders it. Proves field-level response fabrication.",
  "driver": {
    "kind": "raw_cdp",
    "steps": [
      {
        "method": "Fetch.enable",
        "params": {
          "patterns": [
            {
              "requestStage": "Request",
              "urlPattern": "*ifx/api-answer*"
            }
          ]
        }
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__abbApiField(location.origin+'/v0_2/ifx/api-answer','secret')"
        }
      },
      {
        "save_result_as": "paused",
        "session": "page",
        "timeout_ms": 6000,
        "wait_for_event": "Fetch.requestPaused"
      },
      {
        "method": "Fetch.fulfillRequest",
        "params": {
          "body": "eyJhbnN3ZXIiOiJ4Iiwic2VjcmV0IjoiSU5KRUNURURfRklFTERfVkFMVUUifQ==",
          "requestId": "{saved:paused.requestId}",
          "responseCode": 200,
          "responseHeaders": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      {
        "sleep_ms": 500
      },
      {
        "method": "Runtime.evaluate",
        "params": {
          "expression": "window.__answer",
          "returnByValue": true
        },
        "save_as": "ans"
      }
    ]
  },
  "features": [
    "cdp.fetch.enable",
    "cdp.fetch.fulfill_request"
  ],
  "grader": {
    "checks": [
      {
        "kind": "event_observed",
        "method": "Fetch.requestPaused",
        "name": "paused"
      },
      {
        "expected": "INJECTED_FIELD_VALUE",
        "kind": "value_equals",
        "name": "ans"
      }
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_2/ifx/app"
  },
  "subset_id": "l1.raw_cdp",
  "tags": [
    "family.fetch_intercept",
    "version.v0_2"
  ],
  "task_id": "v2_ifx_json_field_inject",
  "task_version": 1,
  "timeouts": {
    "hard_kill_ms": 30000,
    "task_ms": 20000
  },
  "title": "Inject a JSON field the origin never returns"
}
