        "expected": "4",
        "kind": "saved_equals",
        "label": "four_keydowns",
        "name": "keydowns"
      },
      {
        "expected": "yes",
        "kind": "saved_equals",
        "label": "enter_observed",
        "name": "enter_flag"
      },
      {
        "expected": "abc",
        "kind": "saved_equals",
        "label": "typed_text_in_value",
        "name": "typed_value"
      }
    ],
    "kind": "framework_playwright",
    "steps": [
      {
        "op": "new_page"
      },
      {
        "op": "goto",
        "url": "{fixture_url}"
      },
      {
        "op": "focus",
        "selector": "#keys"
      },
      {
        "op": "keyboard_type",
        "text": "abc"
      },
      {
        "key": "Enter",
