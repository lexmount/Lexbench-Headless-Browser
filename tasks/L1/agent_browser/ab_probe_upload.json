{
  "artifact_profile": "l1_standard",
  "description": "Exercises agent-browser probe_list: upload through the agent-browser tool API. It passes when `agent-browser upload #file {tmp_file:up.txt:x}` succeeds; the saved value `v` contains `up.txt`. Only these declared checks affect the verdict.",
  "driver": {
    "connect_env": "BROWSER_WS",
    "env": {
      "AB_CHECKS": [
        {
          "kind": "ab_ok",
          "step": 1
        },
        {
          "expected": "up.txt",
          "kind": "saved_contains",
          "name": "v"
        }
      ],
      "AB_STEPS": [
        {
          "ab": [
            "open",
            "{fixture_url}"
          ]
        },
        {
          "ab": [
            "upload",
            "#file",
            "{tmp_file:up.txt:x}"
          ]
        },
        {
          "eval": "document.querySelector('#file').files[0] && document.querySelector('#file').files[0].name",
          "save_as": "v"
        }
      ]
    },
    "kind": "node_cdp_probe",
    "script": "runner/scripts/l1_ab_probe.js"
  },
  "features": [
    "tool.agent_browser.upload.file"
  ],
  "grader": {
    "checks": [
      "script_reported"
    ],
    "kind": "inline_assertions"
  },
  "layer": "L1",
