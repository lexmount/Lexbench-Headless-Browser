{
  "scenario_id": "wait_list_progressive_fill",
  "family": "waiting_dynamic",
  "title": "Wait for a progressively filled list to complete",
  "description": "Three list items are appended at 150/300/450ms. Waits until all three exist and derives the joined item text.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_4/waiting"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "wait_for_function",
      "expression": "document.querySelectorAll('#list li').length === 3"
    },
    {
      "op": "evaluate",
      "expression": "Array.from(document.querySelectorAll('#list li')).map(function(li){return li.textContent}).join(',')",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "list_complete",
      "step": 2
    },
    {
      "kind": "saved_equals",
      "label": "items_joined",
      "name": "answer",
      "expected": "item-a,item-b,item-c"
    }
  ],
  "cdp_anchors": [
    "cdp.runtime.evaluate"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "item-a,item-b,item-c"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
