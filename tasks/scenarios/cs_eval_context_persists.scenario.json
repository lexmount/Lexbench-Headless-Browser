      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "evaluate",
      "expression": "window.__abb_x = 41, 'set'"
    },
    {
      "op": "evaluate",
      "expression": "String(window.__abb_x + 1)",
      "save_as": "answer"
    }
  ],
