{
  "scenario_id": "cs_eval_context_persists",
  "family": "connect_session",
  "title": "The JS world persists between separate driver evaluate calls",
  "description": "Sets a window global in one evaluate call and derives a value from it in a second call. A driver that evaluates each expression in a throwaway context (or a fresh isolated world) fails here.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "steps": [
