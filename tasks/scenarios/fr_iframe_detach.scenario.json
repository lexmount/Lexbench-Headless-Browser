{
  "scenario_id": "fr_iframe_detach",
  "family": "frames_oopif",
  "title": "Removing an iframe detaches its frame from the tree",
  "description": "Records the initial frame count, removes the first static iframe, waits for the tree to shrink, and answers with the before:after counts.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_4/frames"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "evaluate",
      "expression": "window.__before = window.frames.length; document.getElementById('fa').remove(); 'removed'"
    },
    {
      "op": "wait_for_function",
      "expression": "window.frames.length === window.__before - 1"
    },
    {
      "op": "evaluate",
      "expression": "window.__before + ':' + window.frames.length",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "frame_detached",
      "step": 3
    },
    {
      "kind": "saved_equals",
      "label": "count_shrank",
      "name": "answer",
      "expected": "2:1"
    }
  ],
  "cdp_anchors": [
    "cdp.page.frame_detached",
    "cdp.runtime.evaluate"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "2:1"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
