{
  "scenario_id": "cs_ready_state_complete",
  "family": "connect_session",
  "title": "A settled navigation reports document.readyState complete",
  "description": "Navigates and immediately asks the page for its readyState through the driver's evaluate surface. A driver that returns from goto before the document settles fails here.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "evaluate",
      "expression": "document.readyState",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "goto_ok",
      "step": 1
    },
    {
      "kind": "saved_equals",
      "label": "ready_complete",
      "name": "answer",
      "expected": "complete"
    }
  ],
  "cdp_anchors": [
    "cdp.page.navigate",
    "cdp.runtime.evaluate"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "complete"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
