    {"op": "goto", "url": "{fixture_url}"},
    {"op": "wait_for_selector", "selector": "#late-item"},
    {"op": "text_content", "selector": "#late-item", "save_as": "answer"}
  ],
  "checks": [
    {"kind": "step_ok", "label": "late_item_appeared", "step": 2},
    {"kind": "saved_equals", "label": "late_text", "name": "answer", "expected": "late-28"}
  ],
  "cdp_anchors": ["cdp.dom.query_selector"],
  "expected_answer": {"mode": "equals", "expected": "late-28"},
  "drivers": ["playwright", "puppeteer", "chrome_remote_interface", "cdp_use", "pydoll", "stagehand", "chrome_devtools_mcp", "chromedp", "rod", "chromiumoxide", "ferrum", "agent_browser", "selenium"]
