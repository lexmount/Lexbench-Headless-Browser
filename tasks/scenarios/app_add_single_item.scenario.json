{
  "scenario_id": "app_add_single_item",
  "family": "multi_step_flow",
  "title": "Adding one item is reflected in the server-side cart total",
  "description": "Logs in, adds one item, and answers with the server-computed cart total.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_4/app"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "fill",
      "selector": "#user-in",
      "value": "eve-7"
    },
    {
      "op": "click",
      "selector": "#login-btn"
    },
    {
      "op": "wait_for_function",
      "expression": "document.getElementById('greet').textContent.indexOf('hi-') !== -1"
    },
    {
      "op": "wait_for_function",
      "expression": "!!document.getElementById('add-widget-a')"
    },
    {
      "op": "click",
      "selector": "#add-widget-a"
    },
    {
      "op": "wait_for_function",
      "expression": "!!document.getElementById('cart-widget-a')"
    },
    {
      "op": "wait_for_function",
      "expression": "document.getElementById('cart-total').textContent === 'total-3'"
    },
    {
      "op": "text_content",
      "selector": "#cart-total",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "item_added",
      "step": 6
    },
    {
      "kind": "saved_equals",
      "label": "server_total",
      "name": "answer",
      "expected": "total-3"
    }
  ],
  "cdp_anchors": [
    "cdp.runtime.evaluate",
    "cdp.input.dispatch_mouse_event",
    "cdp.network.request_will_be_sent"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "total-3"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
