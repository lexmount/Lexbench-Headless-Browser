{
  "scenario_id": "app_filter_then_add",
  "family": "multi_step_flow",
  "title": "An item added from a filtered view lands in the cart",
  "description": "Logs in, filters to the gizmo group, adds the first match, and answers with its cart line.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_4/app"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "fill",
      "selector": "#user-in",
      "value": "eve-7"
    },
    {
      "op": "click",
      "selector": "#login-btn"
    },
    {
      "op": "wait_for_function",
      "expression": "document.getElementById('greet').textContent.indexOf('hi-') !== -1"
    },
    {
      "op": "wait_for_function",
      "expression": "document.querySelectorAll('#items li').length === 5"
    },
    {
      "op": "fill",
      "selector": "#filter-in",
      "value": "giz"
    },
    {
      "op": "evaluate",
      "expression": "document.getElementById('filter-in').dispatchEvent(new Event('input', {bubbles: true})); 'fired'"
    },
    {
      "op": "wait_for_function",
      "expression": "document.getElementById('filter-count').textContent === 'giz:2'"
    },
    {
      "op": "click",
      "selector": "#add-gizmo-x"
    },
    {
      "op": "wait_for_function",
      "expression": "!!document.getElementById('cart-gizmo-x')"
    },
    {
      "op": "evaluate",
      "expression": "document.getElementById('cart-gizmo-x').textContent.trim().replace(/ rm$/, '')",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "added_from_filter",
      "step": 9
    },
    {
      "kind": "saved_equals",
      "label": "cart_line",
      "name": "answer",
      "expected": "gizmo-x:1"
    }
  ],
  "cdp_anchors": [
    "cdp.runtime.evaluate",
    "cdp.input.dispatch_mouse_event",
    "cdp.network.request_will_be_sent"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "gizmo-x:1"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
