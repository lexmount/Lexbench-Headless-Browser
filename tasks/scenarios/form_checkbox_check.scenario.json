{
  "scenario_id": "form_checkbox_check",
  "family": "forms",
  "title": "Check a checkbox and observe the checked property",
  "description": "Checks the #checkbox input and reads its live .checked property via evaluate. Exercises the check contract: the driver must toggle the control to a checked state observable on the DOM property, not merely dispatch a click.",
  "layer": "L1",
  "scene": {"kind": "self_hosted_fixture", "url": "/l1/core"},
  "steps": [
    {"op": "new_page"},
    {"op": "goto", "url": "{fixture_url}"},
    {"op": "check", "selector": "#checkbox"},
    {"op": "evaluate", "expression": "document.getElementById('checkbox').checked", "save_as": "answer"}
  ],
  "checks": [
    {"kind": "step_ok", "label": "check_ok", "step": 2},
    {"kind": "saved_truthy", "label": "checkbox_is_checked", "name": "answer"}
  ],
  "cdp_anchors": ["cdp.input.dispatch_mouse_event"],
  "expected_answer": {"mode": "equals", "expected": "true"},
  "drivers": ["playwright", "puppeteer", "chrome_remote_interface", "cdp_use", "pydoll", "stagehand", "chrome_devtools_mcp", "chromedp", "rod", "chromiumoxide", "ferrum", "agent_browser", "selenium"]
}
