{
  "scenario_id": "nav_push_state",
  "family": "navigation_lifecycle",
  "title": "history.pushState changes the URL without a load",
  "description": "Pushes a same-document history entry with a query string and derives the new search plus proof that the document did not reload.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/l1/core"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "evaluate",
      "expression": "window.__abb_alive = 3, history.pushState({}, '', '/l1/core?spa=1'), 'pushed'"
    },
    {
      "op": "evaluate",
      "expression": "location.search + ':' + (window.__abb_alive === 3 ? 'no-reload' : 'reloaded')",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "derive_ok",
      "step": 3
    },
    {
      "kind": "saved_equals",
      "label": "spa_url_no_reload",
      "name": "answer",
      "expected": "?spa=1:no-reload"
    }
  ],
  "cdp_anchors": [
    "cdp.page.navigated_within_document"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "?spa=1:no-reload"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
