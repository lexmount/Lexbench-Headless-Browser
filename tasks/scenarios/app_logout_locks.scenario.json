{
  "scenario_id": "app_logout_locks",
  "family": "multi_step_flow",
  "title": "Logging out drops the server session and relocks the list",
  "description": "Logs in, logs out, and answers with the server farewell plus the relocked list marker.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_4/app"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "fill",
      "selector": "#user-in",
      "value": "eve-7"
    },
    {
      "op": "click",
      "selector": "#login-btn"
    },
    {
      "op": "wait_for_function",
      "expression": "document.getElementById('greet').textContent.indexOf('hi-') !== -1"
    },
    {
      "op": "click",
      "selector": "#logout-btn"
    },
    {
      "op": "wait_for_function",
      "expression": "document.getElementById('greet').textContent.indexOf('bye-') !== -1 && document.getElementById('filter-count').textContent === 'locked'"
    },
    {
      "op": "evaluate",
      "expression": "document.getElementById('greet').textContent + ':' + document.getElementById('filter-count').textContent",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "logged_out",
      "step": 6
    },
    {
      "kind": "saved_equals",
      "label": "farewell_and_lock",
      "name": "answer",
      "expected": "bye-eve-7:locked"
    }
  ],
  "cdp_anchors": [
    "cdp.runtime.evaluate",
    "cdp.input.dispatch_mouse_event",
    "cdp.network.request_will_be_sent"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "bye-eve-7:locked"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
