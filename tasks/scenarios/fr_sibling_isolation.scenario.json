{
  "scenario_id": "fr_sibling_isolation",
  "family": "frames_oopif",
  "title": "Writing into one child frame leaves its sibling untouched",
  "description": "Pokes a computed value into child A's note element and answers with both children's notes, proving sibling frame documents are distinct.",
  "layer": "L1",
  "scene": {
    "kind": "self_hosted_fixture",
    "url": "/v0_4/frames"
  },
  "steps": [
    {
      "op": "new_page"
    },
    {
      "op": "goto",
      "url": "{fixture_url}"
    },
    {
      "op": "wait_for_function",
      "expression": "window.frames.length === 2 && !!frames[0].document.getElementById('note') && !!frames[1].document.getElementById('note')"
    },
    {
      "op": "evaluate",
      "expression": "frames[0].document.getElementById('note').textContent = 'poked-' + (5 * 5); 'poked'"
    },
    {
      "op": "evaluate",
      "expression": "frames[0].document.getElementById('note').textContent + ':' + frames[1].document.getElementById('note').textContent",
      "save_as": "answer"
    }
  ],
  "checks": [
    {
      "kind": "step_ok",
      "label": "poke_ok",
      "step": 3
    },
    {
      "kind": "saved_equals",
      "label": "sibling_untouched",
      "name": "answer",
      "expected": "poked-25:idle"
    }
  ],
  "cdp_anchors": [
    "cdp.page.get_frame_tree",
    "cdp.runtime.evaluate"
  ],
  "expected_answer": {
    "mode": "equals",
    "expected": "poked-25:idle"
  },
  "drivers": [
    "playwright",
    "puppeteer",
    "chrome_remote_interface",
    "cdp_use",
    "pydoll",
    "stagehand",
    "chrome_devtools_mcp",
    "chromedp",
    "rod",
    "chromiumoxide",
    "ferrum",
    "agent_browser",
    "selenium"
  ]
}
